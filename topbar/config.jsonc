{
	/* ------ Size ------ */
	"height": 42,
  "width": "100%",

	/* ------ Position ------ */
  "layer": "top",
  "position": "top",

	/* ------ Margin ------ */
  "margin-right": 10,
  "margin-left": 10,
	"margin-top": 5,
	"margin-bottom": 0,

	/* ------ Modules ------ */
  "modules-left": ["hyprland/workspaces", "tray"],
  "modules-center": ["clock"],
  "modules-right": ["backlight","pulseaudio","network","battery"],

	/* ------ Defining Modules ------ */
	/* ------ Hyprland Workspaces ------ */
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
			"default": " ",
			"active": " ",
    },
    "disable-scroll": true
  },

  /* ------ Tray ------ */
	"tray": {
		"icon-size": 16,
		"spacing": 12,
		"cursor": true,
		"expand": false,
	},

	/* ------ Brightness ------ */
	"backlight": {
    "format": "{icon}",
    "min-length": 2,
    "tooltip-format": "{icon} {percent}%",
		"format-icons": ["󰃚","󰃛","󰃜","󰃝","󰃞", "󰃟", "󰃠"],
		"on-scroll-up": "brightnessctl set 1%+",
		"on-scroll-down": "brightnessctl set 1%-"
	},

	/* ------ Volume ------ */
	"pulseaudio": {
		"tooltip": false,
		"format": "{icon} {volume}%",
		"format-muted": " Muted",
		"on-click": "pamixer -t",
		"on-scroll-up": "pamixer -i 5",
		"on-scroll-down": "pamixer -d 5",
		"scroll-step": 5,
		"format-icons": {
			"headphone": "",
			"default": ["", "", ""]
		}
	},

	/* ------ Network ------ */
	"network": {
		"tooltip": false,
		"format-alt": "{essid} {ipaddr}",
		"format-wifi": "  {signalStrength}%",
		"format-ethernet": "{ipaddr}/{cidr}",
		"format-disconnected": "Disconnected ⚠",
	},

	/* ------ Battery ------ */
	"battery": {
  	"states": {
  	  "full": 100,
  		"good": 95,
  		"warning": 25,
  		"critical": 10
  	},
		"format": "{icon} {capacity}%",
		"format-charging": "{icon} {capacity}%",
		"format-discharging": "{icon} {capacity}%",
		"format-discharging-critical": "󱃍 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"min-length": 6,
		"format-time": "{H}h {m}m",
		"tooltip-format-charging": "󱧥 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-discharging": "󱧦 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-plugged": "󱐋 {power}W\n󱟢 {capacity}%\n󱈑 {health}%\n󱠴 {cycles}",
		"format-icons": {
		  "default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    }
	},

	/* ------ Clock ------ */
	"clock": {
	  "interval": 1,
	  "format": "󰃭 {0:%Y-%m-%d}  {0:%H:%M:%S-%Z}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#b6beca'><b>{}</b></span>",
				"weekdays": "<span color='#75aaf0'><b>{}</b></span>",
				"today": "<span color='#e05f65'><b>{}</b></span>"
			}
		}
	}
}
