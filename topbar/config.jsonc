{
	/* ------ Size ------ */
	"height": 42,
  "width": "100%",

	/* ------ Position ------ */
  "layer": "top",
  "position": "top",

	/* ------ Margin ------ */
  "margin-right": 10,
  "margin-left": 10,
	"margin-top": 5,
	"margin-bottom": 0,

	/* ------ Modules ------ */
  "modules-left": ["hyprland/workspaces", "tray"],
  "modules-center": ["clock#date", "clock#time"],
  "modules-right": ["backlight","group/pulseaudio","network","battery"],

	/* ------ Defining Modules ------ */
	/* ------ Hyprland Workspaces ------ */
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
			"default": " ",
			"active": " ",
    },
    "disable-scroll": true
  },

  /* ------ Tray ------ */
	"tray": {
		"icon-size": 16,
		"spacing": 12,
		"cursor": true,
		"expand": false,
	},

	/* ------ Clock ------ */
	"clock#date": {
	  "format": "󰃭 {0:%Y-%m-%d}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
  			"months": "<span color='#b8c0e0'><b>{}</b></span>", //Macchiato Subtext 1
  			"weekdays": "<span color='#8aadf4'><b>{}</b></span>", //Macchiato Blue
  			"today": "<span color='#ed8796'><b>{}</b></span>" //Macchiato Red
			}
		}
	},
	"clock#time": {
	  "interval": 1,
		"format": " {0:%H:%M:%S-%Z}",
		"timezones": [
		  "", //Represents system's TZ
			"UTC"
		],
		"tooltip-format":"{tz_list}",
		"timezone-tooltip-format":"{0:%Z %H:%M %z}"
	},

	/* ------ Brightness ------ */
	"backlight": {
    "format": "{icon} {percent}%",
    "min-length": 2,
    "tooltip-format": "{icon} {percent}%",
		"format-icons": ["󰃚","󰃛","󰃜","󰃝","󰃞", "󰃟", "󰃠"],
		"on-scroll-up": "brightnessctl set 1%+",
		"on-scroll-down": "brightnessctl set 1%-"
	},

	/* ------ Volume ------ */
	"group/pulseaudio": {
	  "modules": [
			"pulseaudio#output",
			"pulseaudio#input"
			],
		"orientation": "horizontal",
		"drawer": {
			"transition-left-to-right": false
		}
	},
	"pulseaudio#input": {
	  "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 {volume}%",
    "tooltip-format": "{source_desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "target": "source"
	},
	"pulseaudio#output": {
		"format": "{icon} {volume}%",
		"format-muted": "{icon} {volume}%",
		"tooltip-format": "{desc}",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format-icons": {
		  "default": ["󰕿", "󰖀", "󰕾"],
			"default-muted": "󰝟",
			"car": "󰄋",
			"car-muted": "󰸜",
			"hdmi": "󰐯",
			"hdmi-muted": "󱠍",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐",
			"phone": "󰄜",
			"phone-muted": "󰥐",
			"speaker": "󰓃",
			"speaker-muted": "󰓄",
		},
		"target": "sink"
	},

	/* ------ Network ------ */
	"network": {
  	"format": "{icon} {essid}",
    "format-alt": "{icon} 󰳘 {bandwidthUpBytes} 󰱦 {bandwidthDownBytes}",
    "format-disabled": "{icon}",
    "format-disconnected": "{icon}",
    "format-ethernet": "{icon} {ifname}",
    "format-linked": "{icon} {ifname}",
    "format-wifi": "{icon} {essid}",
    "min-length": 2,
    "tooltip-format-disabled": "Network Disabled",
		"tooltip-format-disconnected": "Network Disconnected",
		"tooltip-format-ethernet": "<b>Ethernet</b> {bssid}\n 󱦂 {gwaddr}\n 󰳘 {bandwidthUpBytes}\t󰱦 {bandwidthDownBytes}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
		"tooltip-format-linked": "<b>Interface</b> {ifname}",
		"tooltip-format-wifi": "<b>Wi-Fi</b> {essid}\n 󱦂 {gwaddr}\t󰘚 {bssid}\n 󱄙 {signaldBm} dBm\t󰥛 {frequency} GHz\t󰒢 {signalStrength}%\n 󱚻 {bandwidthTotalBits}\t󰶡 {bandwidthDownBits}\t󰶣 {bandwidthUpBits}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
    "format-icons": {
		  "default": "󰛳",
			"disabled": "󰅛",
			"disconnected": "󰲛",
			"ethernet": "󰈀",
			"linked": "󰌷",
			"wifi": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
		}
	},

	/* ------ Battery ------ */
	"battery": {
	  "interval": 20,
  	"states": {
  	  "full": 100,
  		"warning": 25,
  		"critical": 15,
      "dead": 5
  	},
		"format": "{icon} {capacity}%",
		"min-length": 6,
		"format-time": "{H}h {m}m",
		"tooltip-format": "󱐋 {power}W\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-charging": "󱐋 {power}W\n󱧥 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-discharging": "󱐋 {power}W\n󱧦 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-plugged": "󱐋 {power}W\n󱟢 {capacity}%\n󱈑 {health}%\n󱠴 {cycles}",
		"format-icons": {
		  "default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
			"discharging-critical": "󱃍",
			"plugged": "󰚥",
		},
    "events": {
      "on-discharging-warning": "notify-send -u normal -i battery-level-20-symbolic 'Battery Low' 'Battery at 25%' ",
      "on-discharging-critical": "notify-send -u critical -i battery-level-10-symbolic 'Battery Critical' 'Battery at 15%'",
      "on-discharging-dead": "notify-send -u critical -i battery-level-0-symbolic 'Battery Empty' 'Battery at 5%'",
      "on-charging-full":"notify-send -u low -i battery-level-100-plugged-in-symbolic 'Battery Full' 'Battery at 100%'"
    }
	}
}
