{
	/* ------ Size ------ */
	"height": 42,
  "width": "100%",

	/* ------ Position ------ */
  "layer": "top",
  "position": "top",

	/* ------ Margin ------ */
  "margin-right": 10,
  "margin-left": 10,
	"margin-top": 5,
	"margin-bottom": 0,

	/* ------ Modules ------ */
  "modules-left": ["hyprland/workspaces", "tray"],
  "modules-center": ["clock"],
  "modules-right": ["backlight","group/pulseaudio","network","battery"],

	/* ------ Defining Modules ------ */
	/* ------ Hyprland Workspaces ------ */
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
			"default": " ",
			"active": " ",
    },
    "disable-scroll": true
  },

  /* ------ Tray ------ */
	"tray": {
		"icon-size": 16,
		"spacing": 12,
		"cursor": true,
		"expand": false,
	},

	/* ------ Brightness ------ */
	"backlight": {
    "format": "{icon}",
    "min-length": 2,
    "tooltip-format": "{icon} {percent}%",
		"format-icons": ["󰃚","󰃛","󰃜","󰃝","󰃞", "󰃟", "󰃠"],
		"on-scroll-up": "brightnessctl set 1%+",
		"on-scroll-down": "brightnessctl set 1%-"
	},

	/* ------ Volume ------ */
	"group/pulseaudio": {
	  "modules": [
			"pulseaudio#output",
			"pulseaudio#input"
			],
		"orientation": "horizontal",
		"drawer": {
			"transition-left-to-right": false
		}
	},
	"pulseaudio#input": {
	  "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 {volume}%",
    "tooltip-format": "{source_desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "target": "source"
	},
	"pulseaudio#output": {
		"format": "{icon} {volume}%",
		"format-muted": "{icon} {volume}%",
		"tooltip-format": "{desc}",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format-icons": {
		  "default": ["󰕿", "󰖀", "󰕾"],
			"default-muted": "󰝟",
			"car": "󰄋",
			"car-muted": "󰸜",
			"hdmi": "󰐯",
			"hdmi-muted": "󱠍",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐",
			"phone": "󰄜",
			"phone-muted": "󰥐",
			"speaker": "󰓃",
			"speaker-muted": "󰓄",
		},
		"target": "sink"
	},

	/* ------ Network ------ */
	"network": {
  	"format": "{icon} {essid}",
    "format-alt": "{icon} 󰳘 {bandwidthUpBytes} 󰱦 {bandwidthDownBytes}",
    "format-disabled": "{icon}",
    "format-disconnected": "{icon}",
    "format-ethernet": "{icon} {ifname}",
    "format-linked": "{icon} {ifname}",
    "format-wifi": "{icon} {essid}",
    "min-length": 2,
    "tooltip-format-disabled": "Network Disabled",
		"tooltip-format-disconnected": "Network Disconnected",
		"tooltip-format-ethernet": "<b>Ethernet</b> {bssid}\n 󱦂 {gwaddr}\n 󰳘 {bandwidthUpBytes}\t󰱦 {bandwidthDownBytes}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
		"tooltip-format-linked": "<b>Interface</b> {ifname}",
		"tooltip-format-wifi": "<b>Wi-Fi</b> {essid}\n 󱦂 {gwaddr}\t󰘚 {bssid}\n 󱄙 {signaldBm} dBm\t󰥛 {frequency} GHz\t󰒢 {signalStrength}%\n 󱚻 {bandwidthTotalBits}\t󰶡 {bandwidthDownBits}\t󰶣 {bandwidthUpBits}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
    "format-icons": {
		  "default": "󰛳",
			"disabled": "󰅛",
			"disconnected": "󰲛",
			"ethernet": "󰈀",
			"linked": "󰌷",
			"wifi": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
		}
	},

	/* ------ Battery ------ */
	"battery": {
  	"states": {
  	  "full": 100,
  		"good": 95,
  		"warning": 25,
  		"critical": 10
  	},
		"format": "{icon} {capacity}%",
		"format-charging": "{icon} {capacity}%",
		"format-discharging": "{icon} {capacity}%",
		"format-discharging-critical": "󱃍 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"min-length": 6,
		"format-time": "{H}h {m}m",
		"tooltip-format-charging": "󱧥 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-discharging": "󱧦 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-plugged": "󱐋 {power}W\n󱟢 {capacity}%\n󱈑 {health}%\n󱠴 {cycles}",
		"format-icons": {
		  "default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
		},
    "events": {
      "on-discharging-warning": "notify-send -u normal -i battery-low 'Battery Low' '{capacity}%' ",
      "on-discharging-critical": "notify-send -u urgent -i battery-caution 'Battery Critical' '{capacity}%'",
      "on-charging-full":"notify-send -u low -i battery-full 'Battery Full '{capacity}%'"
    }
	},

	/* ------ Clock ------ */
	"clock": {
	  "interval": 1,
	  "format": "󰃭 {0:%Y-%m-%d}  {0:%H:%M:%S-%Z}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#b6beca'><b>{}</b></span>",
				"weekdays": "<span color='#75aaf0'><b>{}</b></span>",
				"today": "<span color='#e05f65'><b>{}</b></span>"
			}
		}
	}
}
